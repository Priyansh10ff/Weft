# Normalize line endings: LF in the repository and in working copies on every
# OS, so Windows checkouts do not show every file as modified.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.onnx binary
*.sqlite3 binary
