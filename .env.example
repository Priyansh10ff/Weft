# Copy this file to .env and fill in real keys.
#
#   cp .env.example .env
#
# One model provider powers vision, entities and answers. Set one key.
# LLM_PROVIDER=auto picks Claude if ANTHROPIC_API_KEY is set, else Gemini.
# Speaker labels need Gemini (Claude does not accept audio).
# LLM_PROVIDER=auto                    # auto | claude | gemini
# Get a Claude key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GROQ_API_KEY powers Whisper speech transcription for video/audio uploads
# (app/services/audio_processor.py, used by /upload/video and /upload/audio).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override where ChromaDB and uploaded/derived files are stored.
# Defaults to ./chroma_db and ./data if unset.
# MEDIA_STORAGE_ROOT=./data

# Optional: where the SQLite knowledge store lives (default: <MEDIA_STORAGE_ROOT>/knowledge.db).
# KNOWLEDGE_DB_PATH=./data/knowledge.db

# Optional: where the Chroma vector index lives (default: ./chroma_db).
# CHROMA_PATH=./chroma_db

# --- Pipeline tuning (all optional) ---------------------------------------
# GEMINI_MODEL=gemini-3.6-flash        # model used when Gemini is the provider
# SCENE_SAMPLE_SECONDS=0.5             # frame sampling interval for scene detection
# SCENE_CUT_THRESHOLD=0.04             # fraction of changed pixels that starts a new scene
# SCENE_MIN_SECONDS=2                  # shorter changes are treated as transitions
# WINDOW_MAX_SECONDS=30                # long scenes are split at sentence boundaries
# ENABLE_ENTITY_EXTRACTION=true
# ENABLE_SPEAKER_ATTRIBUTION=true
# JOB_WORKERS=2                        # background ingestion workers
# MAX_UPLOAD_MB=500
# ENABLE_DEMO=true                    # allow POST /demo/seed (sample data button on the website)

# --- Security and operations (all optional) -------------------------------
# WEFT_API_KEY=                        # if set, every POST/DELETE needs it as X-API-Key or Authorization: Bearer
# CORS_ORIGINS=                        # comma-separated origins allowed to call the API from a browser; empty = same origin only
# LOG_LEVEL=INFO
